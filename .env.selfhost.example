# Sao chép thành .env.selfhost trên máy chạy Docker. Không commit file thật.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_TTS_MODEL=gpt-4o-mini-tts
ANTHROPIC_TEXT_MODEL=claude-haiku-4-5-20251001
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=10m
LOCAL_MEDIA_BASE_URL=http://host.docker.internal:8765
# Optional: ComfyUI local API. The SDXL Base option appears only after the API and checkpoint probe pass.
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=sd_xl_base_1.0_0.9vae.safetensors
COMFYUI_MODEL_DIR=/Users/your-user/Developer/local-ai/ComfyUI/models/checkpoints
# Optional: the host-only LTX bridge used by local-tools/media_server.py.
LTX_VIDEO_URL=http://127.0.0.1:8770
WORKER_HEALTH_URL=http://worker:8790

ALLOWED_ORIGINS=https://YOUR_GITHUB.github.io
PORT=8787
MAX_UPLOAD_MB=50
DAILY_BUDGET_USD=3
MAX_CONCURRENT_JOBS=1
AI_FEATURES_ENABLED=false
OPENAI_FEATURES_ENABLED=false
ANTHROPIC_FEATURES_ENABLED=false
OLLAMA_FEATURES_ENABLED=false
LOCAL_MEDIA_FEATURES_ENABLED=false
RENDER_WORKER_ENABLED=true
WORKER_POLL_MS=750
RENDER_TIMEOUT_MS=900000
TEMP_RETENTION_HOURS=24
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Encrypts the owners' own OpenAI / Claude keys saved from the website (Cài đặt → Dịch vụ trả phí).
# Generate once: openssl rand -base64 36 | tr -d '\n=+/' | cut -c1-48   Keep a backup: without it saved keys cannot be opened.
API_KEYS_SECRET=

# --- Máy phụ chia tải (tùy chọn). Hướng dẫn: docs/TU-HOST.md, mục "Thêm máy phụ".
# Địa chỉ Tailscale (100.x.y.z) của các Mac khác, dạng tên=địa-chỉ, cách nhau bằng dấu phẩy. Để trống = chỉ chạy trên máy này.
# Dùng địa chỉ IP, không dùng tên .local: container Docker không phân giải được tên mDNS.
AI_NODES=
# Cùng chuỗi với NODE_TOKEN trên máy phụ (xem ~/.studio-node-token trên máy đó).
AI_NODES_TOKEN=
AI_PRIMARY_NODE=mini
# auto: hệ thống đánh giá từng đợt rồi chọn chạy một máy hay song song. single: chỉ máy chính, máy phụ dự phòng. parallel: luôn dùng mọi máy.
AI_BALANCE_MODE=auto
# true: máy phụ chỉ nhận vẽ ảnh/giọng đọc khi cấu hình và mã khớp máy chính (ảnh, giọng cả video đồng nhất).
AI_NODES_STRICT=true
# Laptop chạy pin dưới mức này (%) thì không nhận việc.
AI_NODE_MIN_BATTERY=30
