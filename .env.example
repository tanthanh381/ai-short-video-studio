# Frontend: cac gia tri publishable, khong phai secret
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_API_URL=http://localhost:8787
VITE_DEMO_MODE=true

# API va worker: chi dat tren may tu host, khong commit file .env
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@HOST:5432/postgres
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_TTS_MODEL=gpt-4o-mini-tts
ANTHROPIC_API_KEY=
PEXELS_API_KEY=
PEXELS_API_BASE_URL=https://api.pexels.com/v1
ANTHROPIC_TEXT_MODEL=claude-haiku-4-5-20251001
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:4b
# Vision QA model; use qwen2.5vl because it supports structured JSON on Mini and Air.
OLLAMA_VISION_MODEL=qwen2.5vl:3b
# Used by the Fast preset when the model is installed; otherwise falls back to OLLAMA_MODEL.
OLLAMA_FAST_MODEL=qwen2.5:3b
# Used by the Quality preset only after a live node probe confirms the model is installed.
OLLAMA_QUALITY_MODEL=qwen3:8b
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=10m
LOCAL_MEDIA_BASE_URL=http://host.docker.internal:8765
# Whisper model used by the local transcription bridge. large-v3-turbo is the quality default;
# keep the bridge on the smaller model if the host cannot spare the memory.
FASTER_WHISPER_MODEL=large-v3-turbo
FASTER_WHISPER_COMPUTE_TYPE=int8
FASTER_WHISPER_DEVICE=cpu
# Face redraw pass for generated people (set false to opt out).
FACE_DETAIL=true
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=sd_xl_base_1.0_0.9vae.safetensors
COMFYUI_MODEL_DIR=/path/to/ComfyUI/models/checkpoints
# Optional health-checked adapters. Leave empty until the corresponding local runtime is installed.
ZIMAGE_URL=
FLUX2_URL=
IMAGE_DEFAULT_MODEL=sdxl-turbo
# Optional MusicGen-compatible local service. The worker falls back to an FFmpeg bed when unavailable.
MUSICGEN_URL=
MUSICGEN_ENABLED=false
ALLOWED_ORIGINS=http://localhost:5173,https://YOUR_GITHUB.github.io
WORKER_HEALTH_URL=http://worker:8790
PORT=8787
WORKER_POLL_MS=750
RENDER_TIMEOUT_MS=900000
MAX_CONCURRENT_JOBS=1
AI_FEATURES_ENABLED=false
OPENAI_FEATURES_ENABLED=false
ANTHROPIC_FEATURES_ENABLED=false
OLLAMA_FEATURES_ENABLED=false
LOCAL_MEDIA_FEATURES_ENABLED=false
RENDER_WORKER_ENABLED=false
MAX_UPLOAD_MB=50
DAILY_BUDGET_USD=3
TEMP_RETENTION_HOURS=24
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
