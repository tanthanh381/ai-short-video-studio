# Frontend: cac gia tri publishable, khong phai secret
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_API_URL=http://localhost:8787
VITE_DEMO_MODE=true

# API va worker: chi dat tren may tu host, khong commit file .env
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@HOST:5432/postgres
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_TTS_MODEL=gpt-4o-mini-tts
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=claude-haiku-4-5-20251001
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
LOCAL_MEDIA_BASE_URL=http://host.docker.internal:8765
ALLOWED_ORIGINS=http://localhost:5173,https://YOUR_GITHUB.github.io
PORT=8787
WORKER_POLL_MS=2000
RENDER_TIMEOUT_MS=900000
MAX_CONCURRENT_JOBS=1
AI_FEATURES_ENABLED=false
OPENAI_FEATURES_ENABLED=false
ANTHROPIC_FEATURES_ENABLED=false
OLLAMA_FEATURES_ENABLED=false
LOCAL_MEDIA_FEATURES_ENABLED=false
RENDER_WORKER_ENABLED=false
MAX_UPLOAD_MB=50
DAILY_BUDGET_USD=3
TEMP_RETENTION_HOURS=24
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
CLOUDFLARE_TUNNEL_TOKEN=
